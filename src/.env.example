# GridShield — Environment Variables

# No secrets or API keys are required to run GridShield.
# The app uses only local CSV files and the Python standard library.

# Optional: override the Streamlit server port (default is 8501)
# STREAMLIT_SERVER_PORT=8501

# Optional: if you add a real weather API in the future, add the key here:
# WEATHER_API_KEY=your_key_here

# Optional: if you connect to a real database, add connection string here:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
